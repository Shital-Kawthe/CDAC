mysql> select o.Onum,c.Cname,s.Sname,o.Amt,s.Comm,(o.Amt * s.Comm) As CommissionAmount
    -> from orders o
    -> JOIN customers c ON o.Cnum = c.Cnum
    -> JOIN salespeople s ON o.Snum = s.Snum
    -> WHERE c.Rating > 100;
